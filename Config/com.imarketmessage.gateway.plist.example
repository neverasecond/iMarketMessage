<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.imarketmessage.gateway</string>
    <key>ProgramArguments</key>
    <array>
        <string>/ABSOLUTE/PATH/TO/iMM-gateway</string>
        <string>--dry-run</string>
        <string>--outbox</string>
        <string>/ABSOLUTE/PATH/TO/outbox</string>
        <string>--pairing</string>
        <string>/ABSOLUTE/PATH/TO/paired-self.json</string>
        <string>--ack</string>
        <string>/ABSOLUTE/PATH/TO/gateway-acks.json</string>
    </array>
    <key>StartInterval</key>
    <integer>30</integer>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/dev/null</string>
    <key>StandardErrorPath</key>
    <string>/dev/null</string>
</dict>
</plist>

